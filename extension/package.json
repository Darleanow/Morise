{
  "name": "qt-designer-revamped",
  "displayName": "Qt Designer Revamped",
  "description": "Edit Qt .ui files in VS Code with the real Qt Designer form engine.",
  "version": "0.0.1",
  "private": true,
  "publisher": "local",
  "license": "GPL-3.0-only",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "qtDesignerRevamped.uiEditor",
        "displayName": "Qt Designer",
        "selector": [
          {
            "filenamePattern": "*.ui"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "qtDesignerRevamped.newForm",
        "title": "Qt Designer: New Form..."
      },
      {
        "command": "qtDesignerRevamped.restartBackend",
        "title": "Qt Designer: Restart Backend"
      },
      {
        "command": "qtDesignerRevamped.openAsText",
        "title": "Qt Designer: Open .ui as XML Text"
      }
    ],
    "menus": {
      "explorer/context": [
        { "command": "qtDesignerRevamped.newForm", "when": "explorerResourceIsFolder", "group": "navigation@50" }
      ]
    },
    "configuration": {
      "title": "Qt Designer Revamped",
      "properties": {
        "qtDesignerRevamped.pluginPaths": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "markdownDescription": "Folders that contain a `designer` directory with Qt Designer custom widget plugins (the same layout as `QT_PLUGIN_PATH`). The plugins must be built for the same Qt version as the backend. Restart the backend after changing it."
        },
        "qtDesignerRevamped.backendPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the `designer_backend` executable. Empty uses `../backend/build/designer_backend` relative to the extension folder (development layout)."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/copy-assets.js && tsc -p tsconfig.json && tsc -p tsconfig.webview.json && node scripts/bundle-webview.js",
    "watch": "node scripts/bundle-webview.js --watch",
    "test": "npm run build && node --test out/test/",
    "test:integration": "npm run build && node out/test-integration/run.js",
    "copy-assets": "node scripts/copy-assets.js"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "18.19.0",
    "@types/vscode": "1.90.0",
    "@vscode/codicons": "^0.0.36",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.24.0",
    "jsdom": "^24.1.3",
    "typescript": "5.6.3"
  }
}
