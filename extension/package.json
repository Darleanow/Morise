{
  "name": "formwright",
  "displayName": "Formwright",
  "description": "Edit Qt .ui files in VS Code with the real Qt Designer form engine: layouts, signals and slots, live preview, git compare.",
  "version": "0.1.0",
  "publisher": "darleanow",
  "license": "GPL-3.0-only WITH Qt-GPL-exception-1.0",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#14171c",
    "theme": "dark"
  },
  "categories": [
    "Visual Previews",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "qt",
    "designer",
    "ui",
    "forms",
    "qt6",
    "pyside",
    "pyqt",
    "cpp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Darleanow/Formwright.git"
  },
  "bugs": {
    "url": "https://github.com/Darleanow/Formwright/issues"
  },
  "homepage": "https://github.com/Darleanow/Formwright#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./out/src/extension.js",
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "formwright.uiEditor",
        "displayName": "Formwright",
        "selector": [
          {
            "filenamePattern": "*.ui"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "formwright.newForm",
        "title": "Formwright: New Form..."
      },
      {
        "command": "formwright.restartBackend",
        "title": "Formwright: Restart Backend"
      },
      {
        "command": "formwright.openAsText",
        "title": "Formwright: Open .ui as XML Text"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "formwright.newForm",
          "when": "explorerResourceIsFolder",
          "group": "navigation@50"
        }
      ]
    },
    "configuration": {
      "title": "Formwright",
      "properties": {
        "formwright.pluginPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Folders that contain a `designer` directory with Qt Designer custom widget plugins (the same layout as `QT_PLUGIN_PATH`). The plugins must be built for the same Qt version as the backend. Restart the backend after changing it."
        },
        "formwright.backendPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the `designer_backend` executable. Empty uses `../backend/build/designer_backend` relative to the extension folder (development layout)."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/copy-assets.js && tsc -p tsconfig.json && tsc -p tsconfig.webview.json && node scripts/bundle-webview.js",
    "watch": "node scripts/bundle-webview.js --watch",
    "test": "npm run build && node --test out/test/",
    "test:integration": "npm run build && node out/test-integration/run.js",
    "copy-assets": "node scripts/copy-assets.js",
    "package": "npm run build && node --require ./scripts/file-polyfill.js node_modules/@vscode/vsce/vsce package --no-dependencies --target linux-x64 -o formwright-linux-x64.vsix"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "18.19.0",
    "@types/vscode": "1.90.0",
    "@vscode/codicons": "^0.0.36",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^2.32.0",
    "esbuild": "^0.24.0",
    "jsdom": "^24.1.3",
    "typescript": "5.6.3"
  }
}
