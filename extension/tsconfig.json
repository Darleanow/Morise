{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "out",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true
  },
  "include": ["src/extension.ts", "src/backendClient.ts", "src/uiEditorProvider.ts", "src/protocol.ts", "src/messages.ts", "src/pageBody.ts", "test/**/*.ts", "test-integration/**/*.ts"]
}
